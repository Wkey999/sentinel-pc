{
  "name": "sentinel-pc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "vue-tsc --noEmit && vitest run",
    "tauri": "tauri",
    "desktop:dev": "powershell -NoProfile -File scripts/desktop.ps1 dev",
    "desktop:build": "powershell -NoProfile -File scripts/desktop.ps1 build",
    "test:core": "powershell -NoProfile -File scripts/desktop.ps1 test",
    "format": "prettier --write src tests/*.ts vite.config.ts && powershell -NoProfile -File scripts/format-rust.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
